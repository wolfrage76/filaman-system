---
import '../styles/global.css'
import '../styles/v2.css'
import { VERSION } from '../version.js'

interface Props {
  title: string
  /** 'v2' marks a redesigned page: forces the v2 shell and edge-to-edge main. */
  variant?: 'v1' | 'v2'
}

const { title, variant = 'v1' } = Astro.props
const isV2Page = variant === 'v2'
---

<html lang="en" data-theme="brand">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Fraunces:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline data-v2-page={isV2Page ? '1' : '0'}>
      (function() {
        const t = localStorage.getItem('theme') || 'brand';
        document.documentElement.setAttribute('data-theme', t);
        const l = localStorage.getItem('lang') || 'en';
        document.documentElement.setAttribute('lang', l);
        
        // UI version (admin setting mirrored to localStorage by ui-version.ts)
        try {
          const isV2Page = document.currentScript && document.currentScript.getAttribute('data-v2-page') === '1';
          const ui = localStorage.getItem('fm_ui') === 'v2' ? 'v2' : 'v1';
          const path = location.pathname;
          let target = null;
          if (ui === 'v2') {
            const p = path.replace(/\/+$/, '') || '/';
            let m;
            if (p === '/' || p === '/index.html') target = '/v2/';
            else if (p === '/spools') target = '/v2/spools/';
            else if ((m = p.match(/^\/spools\/(\d+)$/))) target = '/v2/spools/' + m[1];
            else if ((m = p.match(/^\/printers\/(\d+)$/))) target = '/v2/printers/' + m[1];
          } else if (/^\/v2(\/|$)/.test(path)) {
            const rest = path.replace(/^\/v2/, '');
            target = rest === '' || rest === '/' ? '/' : rest;
          }
          if (target && target !== path && target !== path + '/') {
            location.replace(target + location.search);
          }
          if (ui === 'v2' || isV2Page) document.documentElement.classList.add('ui-v2');
        } catch (e) {}

        // Sidebar state
        const s = localStorage.getItem('sidebar-collapsed');
        const isMobile = window.innerWidth <= 768;
        if (s === 'true' || isMobile) {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      })();
    </script>
  </head>
  <body>
    <div id="fm-page" class="fm-page" style="visibility: hidden;">
      <aside class="fm-sidebar fm-surface">
        <button id="sidebar-toggle" class="fm-sidebar-toggle" aria-label="Toggle Sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <div class="fm-sidebar-content">
          <!-- Logo -->
          <div class="fm-logo-container">
            <img src="/logo.png" alt="FilaMan" style="width: 42px; height: 42px; border-radius: 14px; flex-shrink: 0;" />
            <div class="fm-logo-text">
              <div style="font-weight: 700; letter-spacing: 0.6px;">FilaMan</div>
              <small style="color: var(--text-muted); font-size: 0.7rem;" data-i18n="app.subtitle">Filament Management</small>
            </div>
          </div>

          <!-- v2: global search -->
          <label class="v2-only v2-side-search" id="v2-side-search">
            <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round;"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input type="search" id="v2-side-search-input" placeholder="Search spools…" autocomplete="off" />
            <span class="v2-kbd">/</span>
          </label>

          <!-- Navigation -->
          <nav style="display: grid; gap: 6px;">
            <a href="/" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg#icon-dashboard"></use></svg></span>
              <span data-i18n="nav.dashboard">Dashboard</span>
            </a>
            <a href="/manufacturers" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg#icon-manufacturers"></use></svg></span>
              <span data-i18n="nav.manufacturers">Manufacturers</span>
            </a>
            <a href="/filaments" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg#icon-filaments"></use></svg></span>
              <span data-i18n="nav.filaments">Filaments</span>
              <span class="v2-only v2-count" data-v2-count="filaments"></span>
            </a>
            <a href="/spools" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg#icon-spools"></use></svg></span>
              <span data-i18n="nav.spools">Spools</span>
              <span class="v2-only v2-count" data-v2-count="spools"></span>
            </a>
            <a href="/locations" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg#icon-locations"></use></svg></span>
              <span data-i18n="nav.locations">Locations</span>
            </a>
            <a href="/printers" class="fm-nav-item">
              <span class="fm-nav-icon"><svg><use href="/icons.svg#icon-printers"></use></svg></span>
              <span data-i18n="nav.printers">Printers</span>
              <span class="v2-only v2-count" data-v2-count="printers"></span>
            </a>
            <a href="/spool-log" class="fm-nav-item">
              <span class="fm-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span>
              <span data-i18n="nav.spoolLog">Spool Log</span>
            </a>
            <a href="/display" class="fm-nav-item">
              <span class="fm-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span>
              <span data-i18n="nav.display">Display</span>
            </a>

            <div id="v2-live"></div>

            <div id="plugin-nav" class="invisible" style="margin-top: 4px;"></div>

            <div id="admin-nav" class="invisible" style="margin-top: 4px;">
              <hr class="fm-divider" style="margin-bottom: 8px;" />
              <div class="hide-collapsed" style="color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 0 12px; margin-bottom: 6px;" data-i18n="nav.admin">Admin</div>
              <a href="/admin" class="fm-nav-item">
                <span class="fm-nav-icon"><svg><use href="/icons.svg#icon-admin"></use></svg></span>
                <span data-i18n="nav.adminPanel">Admin Panel</span>
              </a>
            </div>
          </nav>

          <!-- Sidebar Footer: User + Theme -->
          <div class="hide-collapsed" style="margin-top: auto; display: grid; gap: 12px;">
            <!-- User Profile Row -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: var(--bg-soft); border-radius: 12px; border: 1px solid var(--border); overflow: hidden;">
              <div style="flex: 1 1 0%; min-width: 0; padding-right: 8px;">
                <div id="user-name" style="font-weight: 600; color: var(--text); font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; width: 100%;">
                  <span style="color: var(--text-muted);" data-i18n="common.loading">Loading...</span>
                </div>
                <div id="user-role" class="invisible" style="color: var(--text-muted); font-size: 0.7rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; width: 100%;">User</div>
              </div>
              <div style="display: flex; gap: 4px; flex-shrink: 0;">
                <a
                  href="/settings"
                  class="fm-btn fm-btn-outline"
                  style="padding: 6px; line-height: 0; border-radius: 8px; flex-shrink: 0;"
                  data-i18n-title="nav.settings"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </a>
                <button
                  id="logout-btn"
                  class="fm-btn fm-btn-outline"
                  style="padding: 6px; line-height: 0; border-radius: 8px; flex-shrink: 0;"
                  data-i18n-title="nav.logout"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </button>
              </div>
            </div>

            <div class="fm-theme-toggle" role="group" aria-label="Theme toggle">
              <button type="button" data-theme="brand" class="active" data-i18n="theme.default">Default</button>
              <button type="button" data-theme="light" data-i18n="theme.light">Light</button>
              <button type="button" data-theme="dark" data-i18n="theme.dark">Dark</button>
            </div>

            <!-- Buy Me A Coffee -->
            <div style="text-align: center; margin-top: 4px;">
              <div style="font-size: 0.7rem; color: var(--text-muted); margin-bottom: 6px;" data-i18n="nav.supportProject">Unterstütze das Projekt</div>
              <a href="https://ko-fi.com/X8X51V6SLP" target="_blank" style="display: inline-block; transition: transform var(--transition);" onmouseenter="this.style.transform='scale(1.05)'" onmouseleave="this.style.transform='scale(1)'">
                <img src="/img/buymeacoffy.png" alt="Buy Me A Coffee" style="height: 44px; width: auto; display: block;" >
              </a>
            </div>

            <div id="sidebar-version-container" style="font-size: 0.7rem; color: var(--text-muted); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4px;">
              <div id="sidebar-version-label">{'v' + VERSION}</div>
              <a
                id="sidebar-version-update"
                href="/admin"
                class="invisible"
                style="display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; font-size: 0.65rem; font-weight: 600; color: var(--info-text, #93c5fd); background: var(--info-bg, rgba(59, 130, 246, 0.15)); border: 1px solid var(--info-border, rgba(59, 130, 246, 0.4)); border-radius: 9999px; text-decoration: none; transition: opacity var(--transition);"
              >
                <span class="fm-dot" style="background: #60a5fa; width: 6px; height: 6px;"></span>
                <span id="sidebar-version-update-text">Update</span>
              </a>
            </div>
            <div style="font-size: 0.7rem; color: var(--text-muted); text-align: center;">
              <a href="https://www.filaman.app" target="_blank" style="color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                Made with <img src="/coffeecup.svg" width="14" height="14" style="vertical-align: middle;"> and <img src="/heart.svg" width="14" height="14" style="vertical-align: middle;"> by Manuel Weiser
              </a>
              <br />
              <span style="font-size: 0.65rem;">MIT License</span>
            </div>
          </div>
        </div>
      </aside>
      <div id="sidebar-backdrop" class="fm-sidebar-backdrop"></div>

      <main class={isV2Page ? 'fm-main-v2' : ''} style={isV2Page ? 'overflow: hidden;' : 'padding: 32px; overflow-y: auto;'}>
        <slot />
      </main>
    </div>

    <!-- Global confirm / alert modal -->
    <div id="fm-confirm-overlay" class="fm-modal-overlay">
      <div class="fm-modal">
        <h3 id="fm-confirm-title" class="fm-modal-title"></h3>
        <p id="fm-confirm-message" class="fm-modal-message"></p>
        <label id="fm-confirm-checkbox-row" class="fm-modal-checkbox" style="display:none">
          <input type="checkbox" id="fm-confirm-checkbox" />
          <span id="fm-confirm-checkbox-label"></span>
        </label>
        <div class="fm-modal-actions">
          <button id="fm-confirm-cancel" class="fm-btn fm-btn-outline"></button>
          <button id="fm-confirm-ok" class="fm-btn fm-btn-danger"></button>
        </div>
      </div>
    </div>


    <script>
      import { t, initI18n, syncLangFromUser, translatePage } from '../lib/i18n'
      import { getAbortSignal } from '../lib/abort'
      import { clearLabelPresetBrowserStorage, ensureLabelPresetBrowserMigration } from '../lib/label-preset-storage'
      import { navHrefFor } from '../lib/plugin-nav'
      import { applyUiVersion, cachedUiVersion, fetchUiVersion, hrefForVersion, type UiVersion } from '../lib/ui-version'

      /* ── i18n init ───────────────────────────────────────────── */
      await initI18n()

      // Expose t and translatePage globally for page scripts
      ;(window as any).__t = t
      ;(window as any).__translatePage = translatePage
      ;(window as any).__syncLangFromUser = syncLangFromUser

      /* ── Global confirm / alert modal ────────────────────────── */
      ;(function setupFmModal() {
        const overlay = document.getElementById('fm-confirm-overlay')!
        const titleEl = document.getElementById('fm-confirm-title')!
        const messageEl = document.getElementById('fm-confirm-message')!
        const okBtn = document.getElementById('fm-confirm-ok')!
        const cancelBtn = document.getElementById('fm-confirm-cancel')!

        const checkboxRow = document.getElementById('fm-confirm-checkbox-row')!
        const checkboxInput = document.getElementById('fm-confirm-checkbox') as HTMLInputElement
        const checkboxLabel = document.getElementById('fm-confirm-checkbox-label')!

        let resolveFn: ((v: any) => void) | null = null
        let checkboxMode = false

        function openModal(title: string, message: string, okLabel: string, cancelLabel: string | null, isDanger: boolean, checkbox?: { label: string; checked?: boolean }): Promise<any> {
          titleEl.textContent = title
          messageEl.textContent = message
          okBtn.textContent = okLabel
          okBtn.className = isDanger ? 'fm-btn fm-btn-danger' : 'fm-btn fm-btn-primary'

          if (cancelLabel) {
            cancelBtn.textContent = cancelLabel
            cancelBtn.style.display = ''
          } else {
            cancelBtn.style.display = 'none'
          }

          if (checkbox) {
            checkboxMode = true
            checkboxLabel.textContent = checkbox.label
            checkboxInput.checked = checkbox.checked ?? false
            checkboxRow.style.display = ''
          } else {
            checkboxMode = false
            checkboxRow.style.display = 'none'
          }

          overlay.classList.add('open')

          return new Promise<any>(resolve => {
            resolveFn = resolve
          })
        }

        function closeModal(result: boolean) {
          overlay.classList.remove('open')
          if (resolveFn) {
            if (checkboxMode) {
              resolveFn(result ? { confirmed: true, checked: checkboxInput.checked } : { confirmed: false, checked: false })
            } else {
              resolveFn(result)
            }
            resolveFn = null
          }
        }

        okBtn.addEventListener('click', () => closeModal(true))
        cancelBtn.addEventListener('click', () => closeModal(false))
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeModal(false)
        })
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal(false)
        })

        // fmConfirm(message, options?) – replacement for window.confirm()
        ;(window as any).__fmConfirm = function(message: string, options?: { title?: string; okLabel?: string; isDanger?: boolean; checkbox?: { label: string; checked?: boolean } }): Promise<any> {
          const title = options?.title || t('common.confirmTitle') || t('common.delete')
          const okLabel = options?.okLabel || t('common.delete')
          const isDanger = options?.isDanger !== undefined ? options.isDanger : true
          return openModal(title, message, okLabel, t('common.cancel'), isDanger, options?.checkbox)
        }

        // fmAlert(message) – replacement for window.alert()
        ;(window as any).__fmAlert = function(message: string): Promise<boolean> {
          return openModal(t('common.errorTitle') || 'Error', message, t('common.close'), null, false)
        }

        // fmSuccess(message) – success-style alert with green title
        ;(window as any).__fmSuccess = function(message: string): Promise<boolean> {
          return openModal(t('common.successTitle') || 'Success', message, t('common.close'), null, false)
        }
      })()


      /* ── Theme switcher ──────────────────────────────────────── */
      const themeButtons = document.querySelectorAll('.fm-theme-toggle button')
      const root = document.documentElement

      function setTheme(theme: string) {
        root.setAttribute('data-theme', theme)
        localStorage.setItem('theme', theme)
        themeButtons.forEach(btn => btn.classList.remove('active'))
        document.querySelector(`.fm-theme-toggle button[data-theme="${theme}"]`)?.classList.add('active')
      }

      // Restore saved theme on load
      const saved = localStorage.getItem('theme') || 'brand'
      setTheme(saved)

      themeButtons.forEach(button => {
        button.addEventListener('click', () => {
          const theme = button.getAttribute('data-theme')!
          setTheme(theme)
        })
      })

      /* ── Auth check ──────────────────────────────────────────── */
      const userName = document.getElementById('user-name')!
      const userRole = document.getElementById('user-role')!
      const logoutBtn = document.getElementById('logout-btn')!
      const adminNav = document.getElementById('admin-nav')!

      async function checkAuth() {
        try {
          const response = await fetch('/api/v1/me', {
            credentials: 'include',
            signal: getAbortSignal(),
          })

          if (!response.ok) {
            // Server explicitly rejected auth — clear cookies and redirect
            document.cookie = 'session_id=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;'
            document.cookie = 'csrf_token=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;'
            window.location.href = '/login'
            return
          }

          const user = await response.json()
          await ensureLabelPresetBrowserMigration(user.id).catch(error => {
            console.warn('Could not migrate label presets to the database', error)
          })

          // Sync language from user profile
          syncLangFromUser(user.language)


          userName.innerHTML = user.display_name || user.email
          userRole.innerHTML = user.roles.join(', ')
          userRole.classList.remove('invisible');

          if (user.is_superadmin || user.permissions.some((p: string) => p.startsWith('admin:'))) {
            adminNav.classList.remove('invisible')
          }

          loadPluginNav()
          checkSystemVersion(user)
          syncUiVersion()

          // Auth succeeded — reveal page content
          document.getElementById('fm-page')!.style.visibility = 'visible'
        } catch (err) {
          // Network abort (e.g. fast page switch) — do NOT clear cookies
          if (err instanceof DOMException && err.name === 'AbortError') return
          if (err instanceof TypeError && (err.message.includes('fetch') || err.message.includes('network'))) return

          // Genuine network error (e.g. disconnected backend) — clear cookies and redirect
          document.cookie = 'session_id=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;'
          document.cookie = 'csrf_token=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;'
          window.location.href = '/login'
        }
      }

      checkAuth()

      /* ── UI version (v1 classic / v2 console) ─────────────────── */
      const IS_V2_PAGE = document.querySelector('script[data-v2-page="1"]') !== null
      let uiVersion: UiVersion = IS_V2_PAGE ? 'v2' : cachedUiVersion()
      applyUiNav(uiVersion)

      async function syncUiVersion() {
        const server = await fetchUiVersion(getAbortSignal())
        if (!server) return
        if (server !== cachedUiVersion() || server !== uiVersion) {
          uiVersion = server
          if (applyUiVersion(server)) return
          // On a v2 page while the setting is v1 the redirect above already fired;
          // otherwise just refresh the shell.
          if (!IS_V2_PAGE) document.documentElement.classList.toggle('ui-v2', server === 'v2')
          applyUiNav(uiVersion)
        }
        if (uiVersion === 'v2') loadV2Sidebar()
      }

      function applyUiNav(version: UiVersion) {
        document.querySelectorAll<HTMLAnchorElement>('.fm-nav-item[href]').forEach(a => {
          const raw = a.dataset.v1Href || a.getAttribute('href') || ''
          if (!a.dataset.v1Href) a.dataset.v1Href = raw
          a.setAttribute('href', hrefForVersion(raw, version))
        })
        highlightActiveNav()
      }

      let v2SidebarLoaded = false
      async function loadV2Sidebar() {
        if (v2SidebarLoaded) return
        v2SidebarLoaded = true
        // Search box → spools list
        const searchInput = document.getElementById('v2-side-search-input') as HTMLInputElement | null
        searchInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            const q = searchInput.value.trim()
            window.location.href = '/v2/spools/' + (q ? `?search=${encodeURIComponent(q)}` : '')
          }
        })
        document.addEventListener('keydown', (e) => {
          if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return
          const el = document.activeElement as HTMLElement | null
          if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' || el.isContentEditable)) return
          e.preventDefault()
          searchInput?.focus()
        })
        loadV2Counts()
        loadV2Live()
        window.addEventListener('filaman:data-changed', (e: Event) => {
          const ev = (e as CustomEvent).detail?.event
          if (ev === 'spools_changed' || ev === 'filaments_changed') loadV2Counts()
          if (ev === 'printer_status' || ev === 'printer_update' || ev === 'slots_update') loadV2Live()
        })
      }

      async function loadV2Counts() {
        const set = (key: string, n: number | undefined) => {
          const el = document.querySelector<HTMLElement>(`[data-v2-count="${key}"]`)
          if (el) el.textContent = typeof n === 'number' ? String(n) : ''
        }
        const total = async (url: string) => {
          try {
            const r = await fetch(url, { credentials: 'include', signal: getAbortSignal() })
            if (!r.ok) return undefined
            const d = await r.json()
            return typeof d.total === 'number' ? d.total : undefined
          } catch { return undefined }
        }
        set('spools', await total('/api/v1/spools?page=1&page_size=1'))
        set('filaments', await total('/api/v1/filaments?page=1&page_size=1'))
        set('printers', await total('/api/v1/printers?page=1&page_size=1'))
      }

      let v2LiveTimer: number | null = null
      async function loadV2Live() {
        const box = document.getElementById('v2-live')
        if (!box) return
        try {
          const r = await fetch('/api/v1/display?fields=slots', { credentials: 'include', signal: getAbortSignal() })
          if (!r.ok) { box.classList.remove('has-live'); return }
          const d = await r.json()
          const printers: any[] = d.printers || []
          if (!printers.length) { box.classList.remove('has-live'); return }
          const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string))
          const stateLabel = (p: any) => {
            const st = String(p.state || '').toLowerCase()
            if (p.connected === false) return { cls: '', text: 'offline' }
            if (st.includes('run') || st.includes('print')) return { cls: 'on', text: 'printing' }
            if (st.includes('pause')) return { cls: 'warn', text: 'paused' }
            if (st.includes('err') || st.includes('fail')) return { cls: 'warn', text: st }
            if (st === 'unknown' || !st) return { cls: p.connected ? 'on' : '', text: p.connected ? 'online' : '—' }
            return { cls: '', text: st }
          }
          box.innerHTML = '<div class="v2-side-label hide-collapsed">Live</div>' + printers.map(p => {
            const sl = stateLabel(p)
            return `<a class="v2-live-item" href="/v2/printers/${p.id}"><span class="v2-dot ${sl.cls}"></span><span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${esc(p.name)}</span><span class="v2-live-meta">${esc(sl.text)}</span></a>`
          }).join('')
          box.classList.add('has-live')
          if (v2LiveTimer) clearTimeout(v2LiveTimer)
          v2LiveTimer = window.setTimeout(loadV2Live, 60000)
        } catch { box.classList.remove('has-live') }
      }

      /* ── System version check ────────────────────────────────── */
      async function checkSystemVersion(user: any) {
        try {
          const cachedRaw = sessionStorage.getItem('fm_version_check')
          if (cachedRaw) {
            try {
              const cached = JSON.parse(cachedRaw)
              if (cached?.ts && Date.now() - cached.ts < 30 * 60 * 1000 && cached.data) {
                applyVersionStatus(cached.data, user)
                return
              }
            } catch { /* ignore corrupted cache */ }
          }

          const resp = await fetch('/api/v1/admin/system/version-check', {
            credentials: 'include',
            signal: getAbortSignal(),
          })
          if (!resp.ok) return
          const data = await resp.json()
          sessionStorage.setItem('fm_version_check', JSON.stringify({ ts: Date.now(), data }))
          applyVersionStatus(data, user)
        } catch { /* Version check is non-critical */ }
      }

      function applyVersionStatus(data: any, user: any) {
        if (!data?.update_available) return
        const updateBadge = document.getElementById('sidebar-version-update') as HTMLAnchorElement | null
        const updateText = document.getElementById('sidebar-version-update-text')
        if (!updateBadge || !updateText) return

        const isAdmin = Boolean(user?.is_superadmin || (user?.permissions || []).some((p: string) => p.startsWith('admin:')))
        if (isAdmin) {
          updateBadge.href = '/admin'
        } else {
          updateBadge.href = 'https://github.com/Fire-Devils/filaman-system/releases/latest'
          updateBadge.target = '_blank'
          updateBadge.rel = 'noopener noreferrer'
        }

        const label = t('nav.updateAvailable') || 'Update available'
        updateText.textContent = data.latest_version ? `${label}: v${data.latest_version}` : label
        updateBadge.title = `${label}: v${data.latest_version || ''}`
        updateBadge.classList.remove('invisible')
      }

      /* ── Plugin navigation ───────────────────────────────────── */
      const pluginNav = document.getElementById('plugin-nav')!

      async function loadPluginNav() {
        try {
          const resp = await fetch('/api/v1/plugin-nav', { credentials: 'include', signal: getAbortSignal() })
          if (!resp.ok) return
          const plugins: { plugin_key: string; name: string; page_url: string }[] = await resp.json()
          if (!plugins.length) return

          const hr = document.createElement('hr')
          hr.className = 'fm-divider'
          hr.style.marginBottom = '8px'
          pluginNav.appendChild(hr)

          const label = document.createElement('div')
          label.className = 'hide-collapsed'
          label.style.cssText = 'color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 0 12px; margin-bottom: 6px;'
          label.setAttribute('data-i18n', 'nav.plugins')
          label.textContent = t('nav.plugins') || 'Plugins'
          pluginNav.appendChild(label)

          for (const p of plugins) {
            const a = document.createElement('a')
            a.href = navHrefFor(p.page_url)
            a.className = 'fm-nav-item'
            a.innerHTML = `<span class="fm-nav-icon"><svg><use href="/icons.svg#icon-plugin"></use></svg></span><span>${p.name}</span>`
            pluginNav.appendChild(a)
          }

          pluginNav.classList.remove('invisible')
          // Re-run active-highlighting now that plugin links are in the DOM,
          // so the longest-prefix match wins across all nav items (including plugins).
          highlightActiveNav()
        } catch { /* Plugin nav is non-critical */ }
      }

      logoutBtn.addEventListener('click', async () => {
        const csrfToken = document.cookie
          .split('; ')
          .find(row => row.startsWith('csrf_token='))
          ?.split('=')[1]

        try {
          await fetch('/auth/logout', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': decodeURIComponent(csrfToken || ''),
            },
            credentials: 'include',
          })
        } finally {
          clearLabelPresetBrowserStorage()
          localStorage.removeItem('lang')
          window.location.href = '/login'
        }
      })

      /* ── Active nav highlighting ─────────────────────────────── */
      function highlightActiveNav() {
        const currentPath = window.location.pathname
        // Plugin pages are told apart by their query, so the entry for the one
        // currently open is only found with it.
        const currentTarget = currentPath + window.location.search
        let bestNavMatch: Element | null = null
        let bestNavLen = 0
        const items = document.querySelectorAll('.fm-nav-item')
        const v1Path = currentPath.replace(/^\/v2(?=\/|$)/, '') || '/'
        items.forEach(item => {
          item.classList.remove('active')
          const href = (item as HTMLElement).dataset.v1Href || item.getAttribute('href')
          if (!href) return
          const cur = item.getAttribute('href') || ''
          const matchesV2 = cur === currentPath || cur === currentPath + '/' || cur === currentTarget
          if (matchesV2 || href === v1Path || href === currentTarget || (href !== '/' && v1Path.startsWith(href + '/'))) {
            if (href.length > bestNavLen) {
              bestNavLen = href.length
              bestNavMatch = item
            }
          }
        })
        if (bestNavMatch) (bestNavMatch as Element).classList.add('active')
      }
      highlightActiveNav()

      /* ── Sidebar toggle ──────────────────────────────────────── */
      const page = document.getElementById('fm-page')!
      const sidebarToggle = document.getElementById('sidebar-toggle')!
      const html = document.documentElement

      // Sync fm-page class with html class on load
      if (html.classList.contains('sidebar-collapsed')) {
        page.classList.add('collapsed')
      }

      function setSidebarCollapsed(collapsed: boolean) {
        if (collapsed) {
          page.classList.add('collapsed')
          html.classList.add('sidebar-collapsed')
        } else {
          page.classList.remove('collapsed')
          html.classList.remove('sidebar-collapsed')
        }
        // Only persist sidebar state on desktop
        if (window.innerWidth > 768) {
          localStorage.setItem('sidebar-collapsed', collapsed ? 'true' : 'false')
        }
      }

      // Update sidebar state
      sidebarToggle.addEventListener('click', () => {
        const isCollapsed = page.classList.contains('collapsed')
        setSidebarCollapsed(!isCollapsed)
      })

      // Close sidebar on mobile when clicking backdrop
      const sidebarBackdrop = document.getElementById('sidebar-backdrop')!
      sidebarBackdrop.addEventListener('click', () => {
        setSidebarCollapsed(true)
      })

      /* ── SSE live-update connection ──────────────────────────── */
      ;(function setupSSE() {
        let es: EventSource | null = null
        let reconnectDelay = 1000

        function connect() {
          es = new EventSource('/api/v1/events/stream')

          es.onmessage = (e) => {
            try {
              const data = JSON.parse(e.data)
              window.dispatchEvent(new CustomEvent('filaman:data-changed', { detail: data }))
            } catch {}
          }

          es.onopen = () => {
            reconnectDelay = 1000
          }

          es.onerror = () => {
            es?.close()
            es = null
            setTimeout(connect, reconnectDelay)
            reconnectDelay = Math.min(reconnectDelay * 2, 30000)
          }
        }

        // Bei Navigation SSE-Connection schließen um HTTP/2-Blockierung zu vermeiden
        window.addEventListener('pagehide', () => {
          es?.close()
          es = null
        })

        connect()
      })()
    </script>
  </body>
</html>
